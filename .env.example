# The application reads these names from environment variables or Java system properties.
CRS_DB_URL=jdbc:mysql://localhost:3306/epda_assignment
CRS_DB_USER=crs_app
CRS_DB_PASSWORD=replace-with-a-local-password

# Optional: required only when Gmail delivery is enabled.
CRS_GMAIL_CLIENT_ID=replace-with-your-client-id
CRS_GMAIL_CLIENT_SECRET=replace-with-your-client-secret
CRS_GMAIL_REFRESH_TOKEN=replace-with-your-refresh-token
