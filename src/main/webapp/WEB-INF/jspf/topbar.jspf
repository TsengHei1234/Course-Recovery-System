<header class="topbar">
    <div>
        <div class="breadcrumbs">
            <span>${requestScope.breadcrumb1}</span>
            <span class="crumb-separator">&gt;</span>
            <span>${requestScope.breadcrumb2}</span>
            <% if (request.getAttribute("breadcrumb3") != null && !String.valueOf(request.getAttribute("breadcrumb3")).isBlank()) { %>
                <span class="crumb-separator">&gt;</span>
                <span><%= request.getAttribute("breadcrumb3") %></span>
            <% } %>
        </div>
        <h1 class="page-title">${requestScope.pageTitle}</h1>
    </div>

    <div class="topbar-right">
        <div class="role-toggle">
            <a class="role-toggle-link ${sessionScope.userRole eq 'admin' ? 'active' : ''}"
               href="${pageContext.request.contextPath}/${requestScope.currentPageFile}?switchRole=admin">
                Course Admin View
            </a>
            <a class="role-toggle-link ${sessionScope.userRole eq 'officer' ? 'active' : ''}"
               href="${pageContext.request.contextPath}/${requestScope.currentPageFile}?switchRole=officer">
                Academic Officer View
            </a>
        </div>

        <div class="user-pill">
            <div class="user-avatar">DU</div>
            <div>
                <div class="user-name">${sessionScope.displayName}</div>
                <div class="user-role">${sessionScope.userRole eq 'admin' ? 'Course Administrator' : 'Academic Officer'}</div>
            </div>
        </div>
    </div>
</header>
