<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<header class="topbar">
    <div>
        <div class="breadcrumbs">
            <span>${requestScope.breadcrumb1}</span>
            <span class="crumb-separator">&gt;</span>
            <span>${requestScope.breadcrumb2}</span>
            <span class="crumb-separator" style="${empty requestScope.breadcrumb3 ? 'display:none;' : ''}">&gt;</span>
            <span style="${empty requestScope.breadcrumb3 ? 'display:none;' : ''}">${requestScope.breadcrumb3}</span>
        </div>
        <h1 class="page-title">${requestScope.pageTitle}</h1>
    </div>

    <div class="topbar-right">
        <div class="user-pill">
            <div class="user-avatar">
                ${empty sessionScope.userName ? "?" : fn:substring(sessionScope.userName, 0, 1)}
            </div>
            <div class="user-meta">
                <div class="user-name">${sessionScope.userName}</div>
                <div class="user-role">${sessionScope.roleName}</div>
            </div>
        </div>
    </div>
</header>