<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="eyebrow">Enterprise System</div>
        <div class="brand-title">CRS</div>
        <div class="brand-subtitle">Course Recovery System</div>
    </div>

    <nav class="sidebar-nav">
        <a class="nav-link ${requestScope.currentPage eq 'users' ? 'active' : ''}"
           href="${pageContext.request.contextPath}/user-management">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </span>
            <span>User Management</span>
        </a>

        <a class="nav-link ${requestScope.currentPage eq 'students' ? 'active' : ''}"
           href="${pageContext.request.contextPath}/students.jsp">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M22 10 12 5 2 10l10 5 10-5z"></path>
                    <path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"></path>
                </svg>
            </span>
            <span>Students</span>
        </a>

        <a class="nav-link ${requestScope.currentPage eq 'courses' ? 'active' : ''}"
           href="${pageContext.request.contextPath}/programs-courses.jsp">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
            </span>
            <span>Programs &amp; Courses</span>
        </a>

        <a class="nav-link ${requestScope.currentPage eq 'recovery-hub' || requestScope.currentPage eq 'recovery-workspace' ? 'active' : ''}"
           style="${sessionScope.roleName eq 'Academic Officer' ? '' : 'display:none;'}"
           href="${pageContext.request.contextPath}/recovery-plans">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9"></circle>
                    <circle cx="12" cy="12" r="5"></circle>
                    <circle cx="12" cy="12" r="1.5"></circle>
                </svg>
            </span>
            <span>Recovery Plans</span>
        </a>

        <a class="nav-link ${requestScope.currentPage eq 'eligibility' ? 'active' : ''}"
           href="${pageContext.request.contextPath}/eligibility">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="9" y="2" width="6" height="4" rx="1"></rect>
                    <path d="M9 4H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"></path>
                    <path d="m9 14 2 2 4-4"></path>
                </svg>
            </span>
            <span>Eligibility &amp; Enrolment</span>
        </a>

        <a class="nav-link ${requestScope.currentPage eq 'reports' ? 'active' : ''}"
           href="${pageContext.request.contextPath}/academic-reports.jsp">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <path d="M14 2v6h6"></path>
                    <path d="M16 13H8"></path>
                    <path d="M16 17H8"></path>
                    <path d="M10 9H8"></path>
                </svg>
            </span>
            <span>Academic Reports</span>
        </a>

        <a class="nav-link ${requestScope.currentPage eq 'email-templates' ? 'active' : ''}"
           href="${pageContext.request.contextPath}/email-templates.jsp">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
            </span>
            <span>Email Templates</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <a class="btn btn-outline btn-block btn-left" href="${pageContext.request.contextPath}/login.jsp?logout=true">Logout</a>
    </div>
</aside>